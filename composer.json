{
    "name": "vexor/framework",
    "description": "Vexor PHP Framework - High Performance, Ultra Secure MVC + Service Layer Framework",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "mvc",
        "secure",
        "jwt",
        "orm"
    ],
    "homepage": "https://github.com/elegancecms/vexor-framework",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vexor\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}