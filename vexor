#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * ═══════════════════════════════════════════════════════════
 *  Vexor Framework — CLI Entry Point
 *  
 *  Usage: php vexor <command> [args] [options]
 *  
 *  Examples:
 *    php vexor serve
 *    php vexor make:model User --migration
 *    php vexor make:controller UserController --api
 *    php vexor route:list
 *    php vexor key:generate
 *    php vexor migrate
 *    php vexor cache:clear
 * ═══════════════════════════════════════════════════════════
 */

$autoload = __DIR__ . '/vendor/autoload.php';

if (!file_exists($autoload)) {
    echo "Please run: composer install\n";
    exit(1);
}

require $autoload;

// Load .env
$envFile = __DIR__ . '/.env';
if (file_exists($envFile)) {
    foreach (file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(trim($line), '#')) continue;
        if (str_contains($line, '=')) {
            [$key, $value] = explode('=', $line, 2);
            $_ENV[trim($key)] = trim($value);
            putenv(trim($key) . '=' . trim($value));
        }
    }
}

$app     = new \Vexor\Core\Application(__DIR__);
$console = new \Vexor\Core\Console\Console($app);

exit($console->run($argv));
